{
  "name": "arsipku",
  "productName": "ARSIPKU",
  "version": "1.0.0",
  "description": "Aplikasi Sistem Informasi Pengelolaan Arsip Sekolah",
  "author": "ARSIPKU",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run prepare:assets && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "npm run prepare:assets && vite build",
    "start": "electron .",
    "dist": "npm run build:renderer && electron-builder --win nsis --x64",
    "prepare:assets": "node scripts/copy-pdfjs-assets.cjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "exceljs": "^4.4.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "id.sekolah.arsipku",
    "productName": "ARSIPKU",
    "copyright": "ARSIPKU",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ARSIPKU-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARSIPKU",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "ARSIPKU",
      "deleteAppDataOnUninstall": false,
      "language": "1057"
    }
  }
}
